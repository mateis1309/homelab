# {{ ansible_managed }}
# mDNS reflector so phones on "trusted" can discover cast targets on "iot".
[server]
use-ipv4=yes
use-ipv6=no
allow-interfaces={% for z in router_mdns_zones %}vlan{{ lab_zones[z].vlan }}{{ "," if not loop.last }}{% endfor %}

ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
enable-wide-area=no

[publish]
disable-publishing=yes

[reflector]
enable-reflector=yes
