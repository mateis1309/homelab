# {{ ansible_managed }}
# The private key is loaded from /etc/wireguard/{{ wireguard_interface }}.key at start-up,
# so it never appears in this file, in Ansible output or in git.
[Interface]
Address = {{ wireguard_address }}
ListenPort = {{ wireguard_port }}
PostUp = wg set %i private-key /etc/wireguard/%i.key
{% for peer in wireguard_peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.ip }}/32
{% endfor %}
