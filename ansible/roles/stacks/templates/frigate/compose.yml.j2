# {{ ansible_managed }}
# NVR for the PoE cameras (VLAN {{ lab_zones['cameras'].vlan }}, no internet).
services:
  frigate:
    image: ghcr.io/blakeblackshear/frigate:{{ frigate_version }}
    container_name: frigate
    restart: unless-stopped
    shm_size: 256mb
    volumes:
      - ./config.yml:/config/config.yml:ro
      - ./media:/media/frigate
      - type: tmpfs
        target: /tmp/cache
        tmpfs:
          size: 1000000000
    networks: [proxy]

networks:
  proxy:
    external: true
