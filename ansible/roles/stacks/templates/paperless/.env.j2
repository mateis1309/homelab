# {{ ansible_managed }}
POSTGRES_PASSWORD={{ vault_paperless_db_password }}
PAPERLESS_DBPASS={{ vault_paperless_db_password }}
PAPERLESS_SECRET_KEY={{ vault_paperless_secret_key }}

# Single sign-on through authentik (OIDC provider "paperless"). token_auth_method is needed since v3.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
{% set oidc = {'openid_connect': {'APPS': [{
     'provider_id': 'authentik', 'name': 'authentik', 'client_id': 'paperless',
     'secret': vault_paperless_oidc_client_secret,
     'settings': {
       'server_url': 'https://auth.' ~ services_domain ~ '/application/o/paperless/.well-known/openid-configuration',
       'token_auth_method': 'client_secret_basic'}}]}} %}
PAPERLESS_SOCIALACCOUNT_PROVIDERS='{{ oidc | to_json }}'
