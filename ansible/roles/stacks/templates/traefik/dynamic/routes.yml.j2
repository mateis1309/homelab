# {{ ansible_managed }}
# Generated from traefik_routes in inventory/group_vars/services.yml
{% set routes = traefik_routes + ([{'name': 'nvr', 'url': 'http://frigate:8971', 'forward_auth': true}] if 'frigate' in stacks_enabled else []) %}
http:
  routers:
    dashboard:
      rule: "Host(`proxy.{{ services_domain }}`)"
      entryPoints: [websecure]
      service: api@internal
      middlewares: [authentik]
    dashboard-outpost:
      rule: "Host(`proxy.{{ services_domain }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      entryPoints: [websecure]
      service: auth
      priority: 100
{% for r in routes %}
    {{ r.name }}:
      rule: "Host(`{{ r.name }}.{{ services_domain }}`)"
      entryPoints: [websecure]
      service: {{ r.name }}
{% if r.forward_auth | default(false) %}
      middlewares: [authentik]
{% endif %}
{% endfor %}
{% for r in routes if r.forward_auth | default(false) %}
{% if loop.first %}
    # authentik embedded outpost callback on every protected host
{% endif %}
    {{ r.name }}-outpost:
      rule: "Host(`{{ r.name }}.{{ services_domain }}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      entryPoints: [websecure]
      service: auth
      priority: 100
{% endfor %}

  services:
{% for r in routes %}
    {{ r.name }}:
      loadBalancer:
        servers:
          - url: "{{ r.url }}"
{% endfor %}

  middlewares:
    authentik:
      forwardAuth:
        address: "http://authentik-server:9000/outpost.goauthentik.io/auth/traefik"
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
    security-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: strict-origin-when-cross-origin
        browserXssFilter: true
