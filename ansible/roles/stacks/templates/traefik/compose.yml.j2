# {{ ansible_managed }}
# Reverse proxy for every web UI. Routes come from a file generated by Ansible,
# so Traefik never needs the Docker socket.
services:
  traefik:
    image: docker.io/library/traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    security_opt: [no-new-privileges:true]
    read_only: true
    ports:
      - "80:80"
      - "443:443"
    env_file: .env
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./dynamic:/etc/traefik/dynamic:ro
      - ./acme:/acme
    networks: [proxy]

networks:
  proxy:
    name: proxy
