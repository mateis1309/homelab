# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
*.tfvars.json

# Secrets: the real vault is never committed (see ansible/vault.example.yml)
ansible/inventory/group_vars/all/vault.yml
.vault_pass*
vault-password*
.env
.env.*
# ...but the .env TEMPLATES are code (secrets come from the vault at render time)
!ansible/roles/stacks/templates/**/.env.j2
*.pem
*.key
id_rsa*
id_ed25519*
wg-*.conf

# Generated
build/
ansible/reports/*.json
*.retry
.ansible/

# Python / editors
.venv/
__pycache__/
*.py[cod]
.DS_Store
.vscode/
.idea/
*.swp
*~
